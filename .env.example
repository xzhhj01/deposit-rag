# 이 파일을 복사해 같은 폴더에 .env 로 저장한 뒤 값을 채운다.  (copy .env.example .env)
# .env 는 형상관리에 올리지 않는다. (NF2003)

# SSAFY GMS 키 (https://gms.ssafy.io/web/)
GMS_KEY=

# 위키백과 API User-Agent 연락처 — 영문 이메일. 없으면 분당 10회로 제한된다. (NF2006)
WIKI_CONTACT=

# 금융감독원 금융상품한눈에 Open API 인증키 (https://finlife.fss.or.kr → 오픈API)
# data/products.json 을 다시 받을 때만 필요하다. 색인 · 앱 실행에는 필요 없다.
FINLIFE_KEY=
